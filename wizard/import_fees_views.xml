<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Import Fees Wizard Form View -->
    <record id="view_import_fees_wizard_form" model="ir.ui.view">
        <field name="name">import.fees.wizard.form</field>
        <field name="model">import.fees.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Fees">
                <group invisible="context.get('show_results', False)">
                    <group>
                        <field name="excel_file" filename="filename" widget="binary"/>
                        <field name="filename" invisible="1"/>
                        <field name="import_batch"/>
                        <field name="sheet_name"/>
                    </group>
                    <group>
                        <field name="skip_header_rows"/>
                        <field name="update_existing"/>
                    </group>
                </group>
                <group invisible="not context.get('show_results', False)">
                    <group>
                        <field name="total_rows" readonly="1"/>
                        <field name="imported_rows" readonly="1"/>
                    </group>
                    <group>
                        <field name="updated_rows" readonly="1"/>
                        <field name="error_count" readonly="1"/>
                    </group>
                    <group colspan="2">
                        <field name="import_log" readonly="1" widget="text"/>
                    </group>
                </group>
                <footer>
                    <button string="Import" name="action_import" type="object" class="btn-primary" invisible="context.get('show_results', False)"/>
                    <button string="View Imported Data" name="action_view_imported_data" type="object" class="btn-primary" invisible="not context.get('show_results', False)"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_import_fees_wizard" model="ir.actions.act_window">
        <field name="name">Import Fees</field>
        <field name="res_model">import.fees.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_ics_fee_staging"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
